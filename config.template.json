{
  "agents": {
    "defaults": {
      "workspace": "/home/odooclaw/.odooclaw/workspace",
      "restrict_to_workspace": true,
      "model_name": "gemini",
      "max_tokens": 8192,
      "temperature": 0.7,
      "max_tool_iterations": 20
    }
  },
  "model_list": [
    {
      "model_name": "gemini",
      "model": "google/gemini-2.5-pro",
      "api_key": "GEMINI_API_KEY_PLACEHOLDER"
    }
  ],
  "channels": {
    "telegram": {
      "enabled": TELEGRAM_ENABLED_PLACEHOLDER,
      "token": "TELEGRAM_TOKEN_PLACEHOLDER",
      "allow_from": [
        "TELEGRAM_USER_ID_PLACEHOLDER"
      ]
    },
    "whatsapp": {
      "enabled": WHATSAPP_ENABLED_PLACEHOLDER,
      "bridge_url": "WHATSAPP_BRIDGE_URL_PLACEHOLDER",
      "use_native": false,
      "allow_from": []
    },
    "odoo": {
      "enabled": true,
      "webhook_host": "0.0.0.0",
      "webhook_port": 18790,
      "webhook_path": "/webhook/odoo",
      "target_db": "ODOO_DB_PLACEHOLDER",
      "allow_from": []
    }
  },
  "tools": {
    "web": {
      "duckduckgo": {
        "enabled": true,
        "max_results": 5
      }
    },
    "mcp": {
      "enabled": true,
      "servers": {
        "odoo-manager": {
          "enabled": true,
          "command": "python3",
          "args": [
            "-m",
            "odoo_mcp.server"
          ],
          "env": {
            "PYTHONUNBUFFERED": "1",
            "ODOO_URL": "ODOO_URL_PLACEHOLDER",
            "ODOO_DB": "ODOO_DB_PLACEHOLDER",
            "ODOO_USERNAME": "ODOO_USERNAME_PLACEHOLDER",
            "ODOO_PASSWORD": "ODOO_PASSWORD_PLACEHOLDER"
          }
        }
      }
    }
  },
  "heartbeat": {
    "enabled": true,
    "interval": 30
  },
  "gateway": {
    "host": "0.0.0.0",
    "port": 18790
  }
}
